{
  "name": "idempotent-payment-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "A PostgreSQL payment-state example with idempotent callbacks and resource generations.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "demo": "node --import tsx examples/scenario.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
